<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

  <display-name>ch14email</display-name>

  <!-- ============ Cau hinh JavaMail (chuong 14) ============
       Moi gia tri o day deu bi BIEN MOI TRUONG cung ten (viet hoa, gach duoi)
       de len: MAIL_MODE, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD,
       MAIL_FROM. Xem EmailListServlet.init().

       mail.mode:
         smtp  - gui qua mot SMTP server bat ky (host/port tu dat). Day la
                 mac dinh, va la che do dung khi deploy len Render.
         local - gui qua SMTP server o localhost:25 (slide 40-43)
         gmail - gui qua smtp.gmail.com:465 (slide 52-55)
         off   - khong gui mail, chi luu CSDL

       VI SAO MAC DINH LA "smtp" CHU KHONG PHAI "gmail":
       Render o goi free CHAN outbound toi port 25, 465 va 587 - dung ba port
       SMTP chuan - nen Gmail khong gui duoc sau khi deploy. Brevo/SendGrid
       con mo SMTP o port 2525 va Render khong chan port do.
       O may ban van co the dat MAIL_MODE=gmail de gui bang Gmail nhu cu.

       mail.password DE TRONG trong file nay. File nay bi commit len git nen
       KHONG bao gio dien mat khau vao day - dat bang bien moi truong. -->
  <context-param>
    <param-name>mail.mode</param-name>
    <param-value>smtp</param-value>
  </context-param>
  <context-param>
    <param-name>mail.host</param-name>
    <param-value>smtp-relay.brevo.com</param-value>
  </context-param>
  <context-param>
    <param-name>mail.port</param-name>
    <param-value>2525</param-value>
  </context-param>

  <!-- Brevo: dung SMTP login dang xxx@smtp-brevo.com (KHONG phai email
       dang nhap tai khoan), lay o Settings > SMTP & API. -->
  <context-param>
    <param-name>mail.username</param-name>
    <param-value></param-value>
  </context-param>
  <context-param>
    <param-name>mail.password</param-name>
    <param-value></param-value>
  </context-param>

  <!-- Dia chi nguoi nhan thay o o "From". Voi Brevo, dia chi nay phai la
       mot sender da duoc xac minh trong tai khoan. -->
  <context-param>
    <param-name>mail.from</param-name>
    <param-value>hoa12358h@gmail.com</param-value>
  </context-param>

  <servlet>
    <servlet-name>EmailListServlet</servlet-name>
    <servlet-class>murach.email.EmailListServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>EmailListServlet</servlet-name>
    <url-pattern>/emailList</url-pattern>
  </servlet-mapping>

  <!-- DataSource jdbc/murach do container cung cap
       (Tomcat: META-INF/context.xml, Jetty: WEB-INF/jetty-env.xml).
       JPA cung dung chinh DataSource nay - xem murach.data.JPAUtil. -->
  <resource-ref>
    <res-ref-name>jdbc/murach</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

</web-app>
